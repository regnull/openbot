inimum\":1,\"maximum\":9007199254740991},\"branchId\":{\"description\":\"Branch identifier\",\"type\":\"string\"},\"needsMoreThoughts\":{\"description\":\"If more thoughts are needed\",\"type\":[\"boolean\",\"string\"]}},\"required\":[\"thought\",\"nextThoughtNeeded\",\"thoughtNumber\",\"totalThoughts\"]},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false},\"execution\":{\"taskSupport\":\"forbidden\"},\"outputSchema\":{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"thoughtNumber\":{\"type\":\"number\"},\"totalThoughts\":{\"type\":\"number\"},\"nextThoughtNeeded\":{\"type\":\"boolean\"},\"branches\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"thoughtHistoryLength\":{\"type\":\"number\"}},\"required\":[\"thoughtNumber\",\"totalThoughts\",\"nextThoughtNeeded\",\"branches\",\"thoughtHistoryLength\"],\"additionalProperties\":false}}]},\"jsonrpc\":\"2.0\",\"id\":2}\n"
