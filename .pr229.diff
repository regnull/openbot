+    expect(listOpen()).toBe(true);
+    await esc(textarea());
+    expect(listOpen()).toBe(false);
+    expect(cancelled).toEqual([]);
+    await type("@co");
+    expect(listOpen()).toBe(false);
+    await esc(textarea());
+    expect(cancelled.sort()).toEqual(["r1", "r2"]);
+  });
+
+  it("offers the mention list again for a new mention after dismissing one", async () => {
+    await mount();
