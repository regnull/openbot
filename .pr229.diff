+    expect(cancelled.sort()).toEqual(["r1", "r2"]);
+    await esc();
+    expect(cancelled).toHaveLength(2);
+  });
+
+  it("does nothing when no run is open", async () => {
+    runs = [];
+    await mount();
+    expect(text()).not.toContain("Esc stop");
+    await esc();
+    expect(cancelled).toEqual([]);
