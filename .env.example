# OpenBot environment. Copy to .env (make setup does this). These defaults start the server with SQLite
# and no keys; everything else (provider API keys, Ollama, embeddings, default model, limits) is
# configured in the UI under Settings and stored in the database. The first UI load shows a setup
# wizard until a chat provider and an embeddings choice are in place.
#
# Only settings the process needs before it can read its own database belong here.

# --- database ----------------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./openbot.db

# --- secrets -----------------------------------------------------------------------------------------
# The one key protecting every secret stored in the database (provider keys, MCP headers, OAuth tokens).
# Leave SECRET_KEY empty to have one generated into SECRET_KEY_FILE on first use (owner-only file).
SECRET_KEY=
SECRET_KEY_FILE=./secret.key

# --- access ------------------------------------------------------------------------------------------
# Optional. When set, the API (and therefore the UI) requires this value as X-API-Key.
OPENBOT_API_KEY=
# Where browsers reach this server; builds the OAuth redirect URI for remote MCP servers.
PUBLIC_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173

# --- paths -------------------------------------------------------------------------------------------
# Root for bots' shell and file tools. "." means the repository itself.
WORKSPACE_ROOT=./workspace
# Plugin tool modules (Python files with @tool functions), loaded at startup.
TOOLS_DIR=./tools
# Built frontend served by the backend at / (make build). Empty means the default, frontend/dist.
FRONTEND_DIST=
# Optional mcpServers file (Claude Code's shape) imported into the database once at startup, then ignored.
MCP_CONFIG=./mcp.json

# --- process -----------------------------------------------------------------------------------------
MAX_CONCURRENT_RUNS=4
SEED_DEMO_BOTS=true
LOG_LEVEL=INFO
LOG_FILE=logs/openbot.log
WEBHOOK_RETRY_DELAYS=5,30,120

# --- tracing (optional) ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=openbot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
