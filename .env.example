DATABASE_URL=sqlite+aiosqlite:///./openbot.db
OPENBOT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
# Local Ollama server, e.g. http://localhost:11434. Setting it enables the `ollama` provider; there is no key.
OLLAMA_BASE_URL=
# Default model offered for new ollama bots. The bot editor lists whatever the server has installed.
OLLAMA_MODEL=
# OpenRouter model used by bot LLM calls. Leave empty for the default openai/gpt-4o-mini.
# BOT_MODEL takes precedence if both are set.
BOT_MODEL=
# Backward-compatible alias for BOT_MODEL.
OPENROUTER_MODEL=
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIMS=1536
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=openbot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
WORKSPACE_ROOT=./workspace
TOOLS_DIR=./tools
MAX_CONCURRENT_RUNS=4
MAX_BOT_HOPS=20
# Token-efficiency controls (see README > Configuration). Defaults shown.
PROMPT_CACHING=true
DIRECT_ANTHROPIC=true
TOOL_OUTPUT_CAP=8000
SHELL_OUTPUT_CAP=4000
CONTEXT_TRIGGER_TOKENS=12000
CONTEXT_CLEAR_AT_LEAST=6000
SUMMARY_TRIGGER_TOKENS=18000
SUMMARY_KEEP_MESSAGES=12
MAX_MODEL_CALLS_PER_RUN=40
HISTORY_TOKEN_BUDGET=24000
HISTORY_MAX_MESSAGES=80
MEMORY_REFLECTION_DELAY=30
SEED_DEMO_BOTS=true
CORS_ORIGINS=http://localhost:5173
WEBHOOK_RETRY_DELAYS=5,30,120
FRONTEND_DIST=
# Console verbosity (DEBUG/INFO/WARNING). The log file below always records DEBUG detail.
LOG_LEVEL=
# Rotating diagnostic log (resolved config, every run's working directory, tool calls/results).
LOG_FILE=
