diff --git a/compose.yaml b/compose.yaml
new file mode 100644
index 0000000..6221d46
--- /dev/null
+++ b/compose.yaml
@@ -0,0 +1,37 @@
+# The backend in Docker, the UI on the host.
+#
+#   echo "OPENBOT_API_KEY=$(openssl rand -hex 24)" >> .env
+#   docker compose up --build
+#
+# Then start the desktop app with `--backend_url http://127.0.0.1:8000`, or run `make frontend`
+# and open http://localhost:5173 (paste the key when it asks). Bots work in ./workspace.
+# OPENBOT_PORT changes the host port if 8000 is taken, e.g. by `make dev`.
+services:
+  backend:
+    build: .
+    ports:
+      - "127.0.0.1:${OPENBOT_PORT:-8000}:8000"
+    env_file:
+      - path: .env
+        required: false
+    environment:
+      # Shell commands run as a separate user without the server's environment, so they can't
+      # read the provider keys, the database or secret.key. That user can still reach the API on
+      # localhost, which is why the API key is required.
+      SHELL_USER: shell
+      OPENBOT_API_KEY: ${OPENBOT_API_KEY:?set OPENBOT_API_KEY, shell commands can reach the API on localhost}
+      # These win over a copied .env, whose paths point at the host.
+      DATABASE_URL: sqlite+aiosqlite:////data/openbot.db
+      SECRET_KEY_FILE: /data/secret.key
+      MCP_TOKEN_KEY_FILE: /data/mcp_token.key
+      MCP_CONFIG: /data/mcp.json
+      LOG_FILE: /data/logs/openbot.log
+      WORKSPACE_ROOT: /workspace
+      TOOLS_DIR: /app/tools
+      FRONTEND_DIST: ""
+    volumes:
+      - openbot-data:/data
+      - ./workspace:/workspace
+
+volumes:
+  openbot-data:
diff --git a/docker-entrypoint.sh b/docker-entrypoint.sh
new file mode 100755
index 0000000..d5efc7b
--- /dev/null
+++ b/docker-entrypoint.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+# Prepares /data and /workspace, then execs the backend. tini (PID 1) passes on the stop signal.
+set -e
+
+# Files the backend writes stay editable by the shell user (same group).
+umask 002
+
+mkdir -p /data/logs
+chmod 700 /data
+
+# /workspace is usually a bind mount, so on Linux this changes the host folder. Only touch it when
+# it isn't set up already, and don't fail if the file system won't allow it.
+mkdir -p /workspace
+if [ "$(stat -c %G:%a /workspace)" != "workspace:2775" ]; then
+    chgrp workspace /workspace && chmod 2775 /workspace \
+        || echo "warning: could not make /workspace group-writable for the shell user" >&2
+fi
+
+exec /app/backend/.venv/bin/python -m openbot.cli --host 0.0.0.0 --port 8000 "$@"
diff --git a/docs/superpowers/specs/2026-09-29-shell-sandbox-design.md b/docs/superpowers/specs/2026-09-29-shell-sandbox-design.md
