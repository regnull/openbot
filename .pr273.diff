+    await go("/threads/t1");
+    await until(() => text().includes("first reply"), "thread after route switch");
+    expect(el.querySelector('[role="menu"]')).toBeNull();
+    expect(trigger().getAttribute("aria-expanded")).toBe("false");
+  });
